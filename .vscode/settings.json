{
  "editor.formatOnSave": true,
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "customLocalFormatters.formatters": [
    {
      "command": "mise exec -- bun fmt --stdin-filepath \"${file}\"",
      "languages": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact",
        "json",
        "jsonc",
        "css",
        "tailwindcss",
        "html"
      ]
    }
  ],
  "[javascript][javascriptreact][typescript][typescriptreact][json][jsonc][css][tailwindcss][html]": {
    "editor.defaultFormatter": "jkillian.custom-local-formatters"
  },
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "./node_modules/typescript"
}
