# Required for Personal-Agent bookings. Use a random secret of at least 32 characters.
# Keep stable across deployments/email retries; rotating invalidates existing cancel links.
POPPY_CANCEL_LINK_SECRET=
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=
CRON_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
BOOKING_AGENT_MODEL=
# WhatsApp Cloud API (optional; local dev uses a stub when unset)
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_SYSTEM_USER_TOKEN=
WHATSAPP_API_VERSION=
WHATSAPP_GRAPH_BASE=
