DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=
CRON_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
BOOKING_AGENT_MODEL=
# WhatsApp Cloud API (optional; local dev uses a stub when unset)
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Server-only AES-256-GCM key: 64 hex characters. Keep stable; changing it
# requires re-encrypting stored school tokens. Required for Embedded Signup.
WHATSAPP_TOKEN_ENCRYPTION_KEY=
WHATSAPP_API_VERSION=
WHATSAPP_GRAPH_BASE=
# Embedded Signup requires a v4 Facebook Login for Business configuration.
# IDs are public browser configuration; app secret/encryption key stay server-only.
WHATSAPP_APP_ID=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
# AgentPhone number rental and inbound SMS/voice verification only.
AGENTPHONE_API_KEY=
# Dedicated voiceMode=webhook agent; configure its webhook at /api/webhooks/agentphone.
AGENTPHONE_VERIFICATION_AGENT_ID=
# Save the signing secret returned when configuring the webhook (updates rotate it).
AGENTPHONE_WEBHOOK_SECRET=
