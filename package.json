{
  "name": "fillthemat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "quickstart": "bun install && bun run setup && bun run dev",
    "dev": "bun scripts/dev-local.ts",
    "dev:stop": "bun scripts/stop-dev-local.ts",
    "setup": "bun scripts/setup-local.ts",
    "doctor": "bun scripts/doctor-local.ts",
    "db:seed": "bun scripts/seed-local.ts",
    "build": "bun run --bun next build",
    "start": "bun run --bun next start",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:migrate:prod": "bun --no-env-file --env-file=.env.production.local scripts/migrate-prod.ts",
    "db:studio": "bunx drizzle-kit studio",
    "supabase:start": "bunx supabase start",
    "supabase:stop": "bunx supabase stop",
    "skills:install": "skills experimental_install -y",
    "skills:update": "skills update -p -y",
    "whatsapp:worker": "bun scripts/whatsapp-worker.ts --once"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.84",
    "@ai-sdk/react": "^4.0.87",
    "@langfuse/otel": "^5.13.0",
    "@langfuse/tracing": "^5.13.0",
    "@langfuse/vercel-ai-sdk": "^5.13.0",
    "@marsidev/react-turnstile": "^1.6.1",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "ai": "^7.0.128",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.2",
    "geist": "^1.7.2",
    "langfuse-cli": "^1.2.4",
    "next": "16.3.3",
    "postgres": "^3.4.9",
    "postman-cli": "^1.69.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.25.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@playwright/test": "^1.62.1",
    "@shadcn/lint": "^0.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/config": "^0.7.0",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.83.0",
    "skills": "^1.5.23",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "bun@1.4.0",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
