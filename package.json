{
  "name": "fillthemat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "bun run --bun next build",
    "build:vercel": "if [ \"$VERCEL_ENV\" = \"production\" ]; then bun run db:migrate:deploy && bun run db:check; fi && bun run build",
    "db:check": "bun --no-env-file scripts/check-migrations.ts",
    "db:check:migrations": "bun --no-env-file scripts/check-migration-metadata.ts && bunx drizzle-kit check",
    "db:check:prod": "bun --no-env-file --env-file=.env.production.local scripts/check-migrations.ts",
    "db:migrate:deploy": "bun --no-env-file scripts/migrate-prod.ts",
    "db:migrate:prod": "bun --no-env-file --env-file=.env.production.local scripts/migrate-prod.ts",
    "db:seed": "bun scripts/seed-local.ts",
    "db:start": "supabase start",
    "db:studio": "bunx drizzle-kit studio",
    "dev": "bun scripts/dev-local.ts",
    "dev:stop": "bun scripts/stop-dev-local.ts",
    "doctor": "bun scripts/doctor-local.ts",
    "eval:assistant": "bun scripts/assistant-eval.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "logs:prod": "bun --no-env-file scripts/logs-prod.ts",
    "pr:queue": "bun --no-env-file scripts/pr-queue.ts",
    "quickstart": "bun install && bun run setup && bun run dev",
    "setup": "bun scripts/setup-local.ts",
    "skills:install": "skills experimental_install -y",
    "skills:update": "skills update -p -y",
    "start": "bun run --bun next start",
    "supabase:start": "bunx supabase start",
    "supabase:stop": "bunx supabase stop",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "bun run --bun next typegen && bun check",
    "vercel": "bunx vercel@63.1.2",
    "vercel:deploy": "bunx vercel",
    "vercel:deploy:prod": "bunx vercel --prod",
    "vercel:env:pull": "bunx vercel env pull",
    "vercel:ignore-build": "bun --no-env-file scripts/ignore-build.ts",
    "verify": "bun run verify:checks && bun run test",
    "verify:checks": "bun run db:check:migrations && bun lint && bun format:check && bun typecheck",
    "whatsapp:worker": "bun scripts/whatsapp-worker.ts --once",
    "wt": "bun scripts/worktree.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.84",
    "@ai-sdk/react": "^4.0.131",
    "@langfuse/client": "5.13.1",
    "@langfuse/otel": "^5.13.0",
    "@langfuse/tracing": "^5.13.0",
    "@langfuse/vercel-ai-sdk": "^5.13.0",
    "@marsidev/react-turnstile": "^1.6.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/otlp-exporter-base": "^0.222.0",
    "@opentelemetry/otlp-transformer": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "ai": "^7.0.128",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.2",
    "geist": "^1.7.2",
    "langfuse-cli": "^1.2.4",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "postman-cli": "^1.69.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.25.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@shadcn/lint": "^0.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/config": "^0.7.0",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.83.0",
    "skills": "^1.5.23",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "packageManager": "bun@1.4.3",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
